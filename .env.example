# Required: private intranet task endpoint for your Seedance-compatible gateway.
# Do not commit real endpoint hostnames, paths, tokens, task IDs, or signed media URLs.
SEEDANCE_API_BASE_URL=https://<intranet-host>/<private-path>/tasks

# Required: API key or gateway credential used by your private endpoint.
SEEDANCE_API_KEY=<replace-with-intranet-credential>
